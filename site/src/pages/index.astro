---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allModules = await getCollection('modules');

const MODULE_METADATA: Record<
  string,
  {
    order: number;
    description: string;
  }
> = {
  'attention-as-lever': {
    order: 1,
    description:
      'A practice for noticing where your attention goes — and choosing where to send it. About ten minutes a day.',
  },
  'the-alignment-system': {
    order: 2,
    description:
      'A navigational framework for matching your task to your state across Being, Doing, Feeling, and Thinking — so effort turns into ease.',
  },
  'the-case-for-self-work-as-service': {
    order: 3,
    description:
      'An exploration of the three illusions of growth — identity, guilt, and service — showing why inner work is a generous gift to everyone around you.',
  },
};

const MODULE_ORDER = [
  'attention-as-lever',
  'the-alignment-system',
  'the-case-for-self-work-as-service',
];

const sortedModules = allModules.sort((a, b) => {
  const indexA = MODULE_ORDER.indexOf(a.id);
  const indexB = MODULE_ORDER.indexOf(b.id);
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return a.data.title.localeCompare(b.data.title);
});
---

<Base
  title="On Balance"
  description="An open playbook for self-actualization practices — exploring attention, alignment, and self-work as service."
>
  <main>
    <header class="hero">
      <h1>On Balance</h1>
      <p class="tagline">An open playbook for self-actualization practices.</p>
    </header>

    <section class="intro">
      <p>
        Your life follows your attention. What you repeatedly attend to becomes
        easier to notice, easier to return to, and easier to become.
      </p>
      <p>
        On Balance is a growing collection of practices for working with attention,
        alignment, and the levers that shape an intentional life. Each module
        stands alone. Each is free to use, free to adapt, and open to contribution.
      </p>
    </section>

    <section class="modules" aria-labelledby="modules-heading">
      <h2 id="modules-heading">Modules</h2>
      <div class="modules-list">
        {sortedModules.map((entry) => {
          const meta = MODULE_METADATA[entry.id];
          return (
            <article class="module-card">
              <h3>
                <a href={`/modules/${entry.id}`}>{entry.data.title}</a>
              </h3>
              <p class="module-summary">{entry.data.summary}</p>
              {meta?.description && (
                <p class="module-description">{meta.description}</p>
              )}
              <p class="cta">
                <a href={`/modules/${entry.id}`}>Read the module →</a>
              </p>
            </article>
          );
        })}
      </div>
    </section>

    <footer class="about" aria-labelledby="about">
      <h2 id="about">About this project</h2>
      <p>
        On Balance is open source. The content is licensed CC BY-SA 4.0; the
        code is Apache-2.0. Copy, adapt, republish, fork.
      </p>
      <ul class="links">
        <li><a href="https://github.com/beaulm/on-balance">Source on GitHub</a></li>
        <li><a href="https://github.com/beaulm/on-balance/blob/main/CONTRIBUTING.md">Contributing</a></li>
        <li><a href="https://github.com/beaulm/on-balance/blob/main/CODE_OF_CONDUCT.md">Code of conduct</a></li>
      </ul>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 65ch;
    margin: 0 auto;
  }

  .hero {
    margin: 2rem 0 3rem;
    text-align: center;
  }

  .hero h1 {
    margin: 0 0 0.5rem;
    font-size: 2.5rem;
  }

  .tagline {
    margin: 0;
    font-size: 1.15rem;
    color: var(--color-accent);
  }

  .intro p {
    font-size: 1.05rem;
  }

  .modules {
    margin: 3rem 0;
  }

  .modules-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .module-card {
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 1.5rem;
    background: #fafafa;
    transition: border-color 0.15s ease;
  }

  .module-card:hover {
    border-color: #bbb;
  }

  .module-card h3 {
    margin-top: 0;
    margin-bottom: 0.25rem;
  }

  .module-card h3 a {
    text-decoration: none;
  }

  .module-card h3 a:hover {
    text-decoration: underline;
  }

  .module-summary {
    font-style: italic;
    color: var(--color-accent);
    margin: 0.25rem 0 0.5rem;
  }

  .module-description {
    margin: 0.5rem 0 1rem;
    color: var(--color-text);
  }

  .cta {
    margin-bottom: 0;
  }

  .about {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
    font-size: 0.95rem;
  }

  .about h2 {
    font-size: 1.15rem;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 1em 0 0;
  }

  .links li {
    margin: 0.4em 0;
  }

  @media (max-width: 640px) {
    .hero h1 {
      font-size: 2rem;
    }

    .module-card {
      padding: 1.25rem;
    }
  }
</style>
